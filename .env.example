# zaffiliate environment contract — copy to .env and adjust.
# NEVER commit .env, real credentials, provider tokens, private keys, or production URLs.
# Empty values are optional unless a section says otherwise.

# =============================================================================
# Core runtime
# =============================================================================

# development | test | staging | production
APP_ENV=development

# Public API and operator web ports.
PORT=8080
WEB_PORT=3000

# Required in production. Localhost values are for host-based development;
# compose.yaml injects the private service names postgres and redis instead.
DATABASE_URL=postgresql://zaffiliate:zaffiliate@127.0.0.1:5432/zaffiliate
REDIS_URL=redis://127.0.0.1:6379/0

# Affiliate domain state backend: memory | postgres.
# When empty, production defaults to postgres and non-production defaults to memory.
# Explicit postgres mode is fail-closed and requires DATABASE_URL.
AFFILIATE_RUNTIME_BACKEND=

# debug | info | warn | error
LOG_LEVEL=info

# =============================================================================
# Application secrets — server-only
# =============================================================================

# bootstrap.sh/bootstrap.ps1 generate local values when these are empty.
# Use independent cryptographically random values of at least 32 characters.
# SESSION_SECRET is required in production; ENCRYPTION_KEY protects stored data.
# ENCRYPTION_KEY is also mandatory when a production OAuth provider is enabled;
# PKCE verifier/nonce bundles and provider access/refresh tokens are AES-256-GCM
# encrypted at rest.
SESSION_SECRET=
ENCRYPTION_KEY=

# Salt for privacy-preserving click/visitor identifiers.
VISITOR_SALT=

# =============================================================================
# OAuth / OIDC account linking — optional, server-only
# =============================================================================

# Configure all required OAuth values together or leave OAUTH_PROVIDER_ID empty
# to disable the production OAuth boundary. Authorize/token/issuer/redirect URLs
# must use HTTPS and public hosts; localhost/private ranges are rejected.
OAUTH_PROVIDER_ID=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_AUTHORIZE_URL=
OAUTH_TOKEN_URL=
OAUTH_REDIRECT_URI=
OAUTH_ISSUER=
OAUTH_SCOPE=

# Optional verified OIDC mode. When this is set, OAUTH_SCOPE must include
# "openid". The runtime generates and encrypts an authorization nonce, requires
# an id_token, and verifies RS256 signature + issuer + audience + expiry + nonce
# before the signed `sub` can become the external identity subject. The JWKS
# endpoint must also be public HTTPS and is fetched with redirects disabled,
# a timeout, bounded response size, and SSRF/private-host protections.
OAUTH_JWKS_URI=

# =============================================================================
# Object storage — S3-compatible
# =============================================================================

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# =============================================================================
# MoneyPrinterTurbo video provider — server-only
# =============================================================================

# Use the private Compose service URL on VMware Ubuntu 26.04. Do not expose the
# MoneyPrinterTurbo worker port, Redis, or PostgreSQL to the public network.
MONEYPRINTER_URL=http://moneyprinter:8080

# Generate a unique high-entropy value. It must exactly match MoneyPrinterTurbo
# [app].api_key and must never be sent to the browser or committed.
MONEYPRINTER_API_KEY=

# =============================================================================
# Supabase — optional runtime integration
# =============================================================================

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy aliases supported by the runtime. Prefer the variables above and leave
# these empty unless an existing Supabase project still uses the old names.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Inputs used only by scripts/derive-pooler-url.mjs.
SUPABASE_DB_URL=
SUPABASE_PROJECT_ID=
SUPABASE_PROJECT_REGION=
SUPABASE_DB_USER=postgres
SUPABASE_DB_NAME=postgres

# =============================================================================
# Provider probes — optional, server-only
# =============================================================================

# Used by scripts/tiktok-sandbox-probe.mjs. Keep both empty outside an isolated
# TikTok sandbox/review environment.
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=

# =============================================================================
# Observability
# =============================================================================

OTEL_EXPORTER_OTLP_ENDPOINT=

# =============================================================================
# Database migration, restore, and migration-evidence tooling
# =============================================================================

# Override only when migrations do not live in db/migrations.
MIGRATIONS_DIR=

# restore-rehearsal.mjs accepts only an isolated localhost database target.
# Never point this variable at staging or production.
RESTORED_DATABASE_URL=

# Optional legacy-repository evidence output directory.
LEGACY_BACKUP_DIR=/home/cvsz/legacy-migration-backup

# =============================================================================
# Release tooling — optional local overrides
# =============================================================================

# GitHub Actions supplies GITHUB_SHA, GITHUB_WORKFLOW, GITHUB_RUN_ID, and
# GITHUB_RUN_NUMBER automatically; do not duplicate them here.
RELEASE_VERSION=
RELEASE_CREATED_AT=
COMMIT_SHA=
GPG_PASSPHRASE=

# Cloudflare credentials are deliberately excluded. scripts/deploy-host.sh
# reads CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID from the separate,
# permission-restricted ~/zeaz/.env.cloudflare file.
