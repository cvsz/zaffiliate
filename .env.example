# zaffiliate environment template — copy to .env and adjust.
# NEVER put real credentials in this file or in .env committed to git.

APP_ENV=development
PORT=8080

# Postgres (compose default below matches docker-compose credentials)
DATABASE_URL=postgresql://zaffiliate:zaffiliate@127.0.0.1:5432/zaffiliate

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Object storage (S3-compatible; local stack may provide MinIO-class service later)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# MoneyPrinterTurbo video provider (server-only).
# In Docker Compose use the private service URL; never publish the worker port.
MONEYPRINTER_URL=http://moneyprinter:8080
# Generate a unique high-entropy value and keep it identical to MoneyPrinterTurbo app.api_key.
MONEYPRINTER_API_KEY=

# Secrets — bootstrap.sh generates local-only values when absent.
# Minimum 32 characters each; required in production.
SESSION_SECRET=
ENCRYPTION_KEY=

# Salt used to hash visitor identifiers for click attribution (generated locally if absent)
VISITOR_SALT=

# Observability
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
GPG_PASSPHRASE=
